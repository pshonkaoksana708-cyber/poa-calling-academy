# Public site URL for metadata, Open Graph, robots.txt and sitemap.xml.
# Fill this in Vercel after the temporary or production URL is known.
NEXT_PUBLIC_SITE_URL=

# Optional server-side fallback for metadata, robots.txt and sitemap.xml.
SITE_URL=

# Required in production for signing protected course access tokens.
# Do not commit a real secret here. Set the real value in Vercel Environment Variables.
ACCESS_TOKEN_SECRET=

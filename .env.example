# Public site URL for non-critical integrations.
# Core SEO metadata, canonical, robots.txt and sitemap.xml use https://www.poacalling.com.
NEXT_PUBLIC_SITE_URL=

# Optional server-side site URL for non-critical integrations.
SITE_URL=

# Optional site verification codes.
# Set these in Vercel after Google Search Console and Yandex Webmaster provide the values.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=

# Google Analytics 4 Measurement ID.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-KT4MZWN9RV

# Required in production for signing protected course access tokens.
# Do not commit a real secret here. Set the real value in Vercel Environment Variables.
ACCESS_TOKEN_SECRET=

# Robokassa payment integration.
# Do not commit real Robokassa passwords. Set them in Vercel Environment Variables.
ROBOKASSA_MERCHANT_LOGIN=
ROBOKASSA_PASSWORD_1=
ROBOKASSA_PASSWORD_2=
ROBOKASSA_TEST_PASSWORD_1=
ROBOKASSA_TEST_PASSWORD_2=
ROBOKASSA_IS_TEST=

# Optional email delivery for paid course access.
# Create these values in your email provider account and set them in Vercel.
RESEND_API_KEY=
ACCESS_EMAIL_FROM=
